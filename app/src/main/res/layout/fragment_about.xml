<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="30dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/img"
            app:shapeAppearanceOverlay="@style/CircleImage"/>

        <TextView
            android:fontFamily="@font/s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="SolarGuard v1.0"
            android:textColor="@color/ios_text_black"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:fontFamily="@font/y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Innovative AI solution for solar safety. Created for Technovation Girls 2026."
            android:textColor="@color/ios_text_gray"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="30dp"
            android:background="#DDD"/>

        <TextView
            android:fontFamily="@font/m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developer"
            android:textColor="@color/ios_blue"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_team_list"
            android:fontFamily="@font/r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Aslzoda"
            android:textColor="@color/ios_text_black"
            android:lineSpacingExtra="5dp"/>

    </LinearLayout>
</ScrollView>