<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profile_image"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/user"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeWidth="4dp"
                app:strokeColor="@color/white"
                android:elevation="4dp"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_edit_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/profile_image"
                android:layout_alignEnd="@id/profile_image"
                android:src="@android:drawable/ic_menu_edit"
                app:fabCustomSize="35dp"
                app:backgroundTint="@color/ios_blue"
                app:tint="@color/white"
                app:elevation="6dp"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_user_name"
            android:fontFamily="@font/y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Aslzoda Bozorboyeva"
            android:textColor="@color/ios_text_black"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="#DDDDDD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <include
                    android:id="@+id/itemEmail"
                    layout="@layout/item_profile_info" />

                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#DDD" android:layout_marginStart="45dp"/>

                <include
                    android:id="@+id/itemPhone"
                    layout="@layout/item_profile_info" />

                <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#DDD" android:layout_marginStart="45dp"/>

                <include
                    android:id="@+id/itemLocation"
                    layout="@layout/item_profile_info" /> </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btn_edit_all"
            android:fontFamily="@font/y"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/ios_blue"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>