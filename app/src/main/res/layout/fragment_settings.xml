<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg_gray"
    android:orientation="vertical"
    android:padding="20dp">



    <TextView
        android:fontFamily="@font/y"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="8dp"
        android:text="DATA MANAGEMENT"
        android:textColor="@color/ios_text_gray"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:fontFamily="@font/y"
                android:id="@+id/btn_clear_data"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp"
                android:text="Clear all data"
                android:textColor="@color/ios_blue"
                android:textSize="17sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="15dp"
                android:background="#DDD" />

            <TextView
                android:fontFamily="@font/y"
                android:id="@+id/btn_delete_account"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp"
                android:text="Account deletion and abandonment"
                android:textColor="@color/ios_red"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:fontFamily="@font/y"
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/ios_button_bg"
        android:gravity="center"
        android:text="Log Out"
        android:textColor="@color/ios_red"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>